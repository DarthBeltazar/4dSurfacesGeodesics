[
 {"type": "mf.hyperplane", "group": "Многообразия", "title": "Гиперплоскость R³", "output": "manifold",
  "params": [], "formula": "w", "legacy_kind": "hyperplane"},
 {"type": "mf.S3", "group": "Многообразия", "title": "S³", "output": "manifold",
  "params": [{"name": "R", "type": "float", "default": 1.0, "min": 0.1, "max": 10.0}],
  "formula": "length(x, y, z, w) - R", "legacy_kind": "S3"},
 {"type": "mf.spheritorus", "group": "Многообразия", "title": "Сферитор", "output": "manifold",
  "params": [{"name": "R", "type": "float", "default": 1.0, "min": 0.1, "max": 10.0},
             {"name": "r", "type": "float", "default": 0.4, "min": 0.01, "max": 10.0}],
  "formula": "length(length(x, y, z) - R, w) - r", "legacy_kind": "spheritorus"},
 {"type": "mf.torisphere", "group": "Многообразия", "title": "Ториосфера", "output": "manifold",
  "params": [{"name": "R", "type": "float", "default": 1.0, "min": 0.1, "max": 10.0},
             {"name": "r", "type": "float", "default": 0.4, "min": 0.01, "max": 10.0}],
  "formula": "length(length(x, y) - R, z, w) - r", "legacy_kind": "torisphere"},
 {"type": "mf.tiger", "group": "Многообразия", "title": "T³ («тигр»)", "output": "manifold",
  "params": [{"name": "R1", "type": "float", "default": 1.2, "min": 0.1, "max": 10.0},
             {"name": "R2", "type": "float", "default": 0.8, "min": 0.1, "max": 10.0},
             {"name": "r", "type": "float", "default": 0.3, "min": 0.01, "max": 10.0}],
  "formula": "length(length(x, y) - R1, length(z, w) - R2) - r", "legacy_kind": "tiger"},
 {"type": "mf.ellis", "group": "Многообразия", "title": "Червоточина Эллиса", "output": "manifold",
  "params": [{"name": "b", "type": "float", "default": 1.0, "min": 0.05, "max": 10.0}],
  "formula": "length(x, y, z) - b * cosh(w * (1.0 / b))", "legacy_kind": "ellis"},
 {"type": "mf.compact_wh", "group": "Многообразия", "title": "Компактная червоточина", "output": "manifold",
  "params": [{"name": "b", "type": "float", "default": 1.0, "min": 0.05, "max": 10.0},
             {"name": "rho0", "type": "float", "default": 3.0, "min": 0.1, "max": 50.0},
             {"name": "W", "type": "float", "default": 1.5, "min": 0.05, "max": 10.0}],
  "formula": "w * w - compact_h(length(x, y, z), b, rho0, W)", "legacy_kind": "compact_wh"},
 {"type": "mf.two_compact_wh", "group": "Многообразия", "title": "Две компактные червоточины", "output": "manifold",
  "params": [{"name": "c1", "type": "vec3", "default": [-4.0, 0.0, 0.0]},
             {"name": "c2", "type": "vec3", "default": [4.0, 0.0, 0.0]},
             {"name": "b", "type": "float", "default": 1.0, "min": 0.05, "max": 10.0},
             {"name": "rho0", "type": "float", "default": 3.0, "min": 0.1, "max": 50.0},
             {"name": "W", "type": "float", "default": 1.5, "min": 0.05, "max": 10.0}],
  "formula": "w * w - (compact_h(length(x - c1.x, y - c1.y, z - c1.z), b, rho0, W) + compact_h(length(x - c2.x, y - c2.y, z - c2.z), b, rho0, W) - W * W)",
  "legacy_kind": "two_compact_wh"}
]
